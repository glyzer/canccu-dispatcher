#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# canccu-up [--project <name>] — create the project's tmux session if it is missing: "canccu" for the
# default project, "canccu-<name>" for the others. Window main: the lead (claude) on the left,
# canccu-monitor --project <name> on the right; window dispatch: canccu-dispatch --project <name>;
# window shell. Every pane has CANCCU_PROJECT=<name> and the project's gh login (GH_CONFIG_DIR, with
# git's credential helper for it), when it has one. Then attach. Never kills or rearranges an
# existing session (docs/canccu-dispatch.md, "Moving to the command-center layout").
set -uo pipefail
self=$(realpath "$0")
# shellcheck source=../lib/canccu-common.sh
. "$(dirname "$self")/../lib/canccu-common.sh"

S=$TMUX_SESSION H=$CANCCU_HOME
mkdir -p "$H" ~/code || exit 1
touch "$H/dispatch.log"
if ! tmux has-session -t "=$S" 2>/dev/null; then
  # every pane (and every later window: the session environment) acts on this project: a
  # canccu-stop typed in canccu-<name> never falls back to the default project
  P="CANCCU_PROJECT=$CANCCU_PROJECT"
  # … and with the project's own gh login (tmux_gh_env: GH_CONFIG_DIR, its owner and git's
  # credential helper for it; sent empty without one), so the lead's gh and git use it too. With
  # one, the token variables go empty as well: gh prefers a token the server inherited. The
  # client that may start the server runs without them (without_gh_env): never the global
  # environment of every later session. -e on new-session sets the session environment too.
  mapfile -d '' GE < <(tmux_gh_env; [ -n "$CANCCU_GH_DIR" ] && tmux_token_blanks)
  lead=$(without_gh_env tmux new-session -d -P -F '#{pane_id}' -e "$P" "${GE[@]}" -s "$S" -n main -c ~/code) || die "tmux new-session $S failed"
  tmux set-environment -t "=$S" CANCCU_PROJECT "$CANCCU_PROJECT"
  mon=$(tmux split-window -h -l 40% -P -F '#{pane_id}' -e "$P" "${GE[@]}" -t "$lead" -c ~/code) || die "tmux split-window failed"
  disp=$(tmux new-window -d -P -F '#{pane_id}' -e "$P" "${GE[@]}" -t "=$S:" -n dispatch -c ~/code) || die "tmux new-window dispatch failed"
  tmux new-window -d -e "$P" "${GE[@]}" -t "=$S:" -n shell -c ~/code || die "tmux new-window shell failed"
  tmux select-pane -t "$lead" -T lead
  tmux select-pane -t "$mon" -T monitor
  tmux send-keys -t "$disp" "canccu-dispatch --project $CANCCU_PROJECT" C-m
  tmux send-keys -t "$mon" "canccu-monitor --project $CANCCU_PROJECT" C-m
  tmux send-keys -t "$lead" 'claude' C-m
  tmux select-pane -t "$lead"
elif ! dispatcher_running; then
  echo "canccu-up: session $S exists but canccu-dispatch is not running for project $CANCCU_PROJECT; start it in its window dispatch (or any window): canccu-dispatch --project $CANCCU_PROJECT" >&2
fi
if [ -t 1 ]; then
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$S"; else exec tmux attach -t "=$S"; fi
fi
