#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# canccu-resume [--project <name>] — undo canccu-pause: the dispatcher starts new issues again.
set -uo pipefail
self=$(realpath "$0")
# shellcheck source=../lib/canccu-common.sh
. "$(dirname "$self")/../lib/canccu-common.sh"

rm -f "$CANCCU_HOME/paused" && log "resumed (canccu-resume)"
