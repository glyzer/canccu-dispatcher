#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# canccu-resume [--project <name>] [--usage] — undo canccu-pause: the dispatcher starts new runs again; --usage also clears the usage-limit back-off and the usage reading (after an early reset).
set -uo pipefail
self=$(realpath "$0")
# --usage comes off first: lib/canccu-common.sh only takes a --project that leads the arguments
usage=0 args=()
for a in "$@"; do [ "$a" = --usage ] && usage=1 || args+=("$a"); done
set -- "${args[@]}"
# shellcheck source=../lib/canccu-common.sh
. "$(dirname "$self")/../lib/canccu-common.sh"
act_track "canccu-resume$( ((usage)) && echo " --usage")"

rm -f "$CANCCU_HOME/paused" "$CANCCU_HOME/.warned-paused-start" && log "resumed (canccu-resume)"
# one account serves every project on the host, so the back-off and each project's reading go;
# with no reading nothing is throttled, and the next run writes the real numbers
if (( usage )); then
  rm -f "$CANCCU_ROOT/backoff" "$CANCCU_ROOT"/projects/*/workers/usage.json &&
    log "usage limit cleared (canccu-resume --usage): runs start again"
  # a worker nudged at the usage stop would set the old reset again when it is reaped
  for f in "$CANCCU_ROOT"/projects/*/state/*; do
    if [ -f "$f" ] && grep -q '^nudge_reset=.' "$f"; then kv_set "$f" "${f##*/}" nudge_reset=; fi
  done
fi
