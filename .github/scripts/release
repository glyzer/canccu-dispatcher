#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# .github/scripts/release — the steps of release.yml (and CI's tarball), run in the repo's top dir:
#   release check <tag>              the tag is v<VERSION>, and CHANGELOG.md has a dated section
#                                    "## [<version>] — <date>" for it (not "unreleased")
#   release check <tag> --body <f>   also: the release PR body in <f> has the line
#                                    "Scenarios: pass at <short sha>" (tests/scenarios/run), and
#                                    when the reviewer changed since the last tag (review_gate),
#                                    "Review set: pass at <short sha>" (tests/review-set/run)
#   release notes <version>          print that section's body: the release notes
#   release build <version> <dir>    git archive of HEAD as <dir>/canccu-dispatcher-<version>.tar.gz
#                                    (every file under canccu-dispatcher-<version>/), plus
#                                    <dir>/SHA256SUMS
# Exit 0 ok, 1 a check failed, 2 a usage error.
set -uo pipefail

die() { echo "release: $1" >&2; exit "${2:-1}"; }
usage() { sed -n '3,12s/^# \{0,1\}//p' "$0" >&2; exit 2; }

version() { local v=""; { read -r v < VERSION; } 2>/dev/null; printf '%s\n' "${v//[[:space:]]/}"; }

# section <version>: the CHANGELOG.md section of that version, its heading first. The version is
# matched as a literal: 1.2.4 must not find 1.2.40, nor its dots any character.
section() {
  awk -v want="## [$1]" '
    /^## / { if (on) exit; on = (substr($0, 1, length(want)) == want) }
    on' CHANGELOG.md 2>/dev/null
}

# review_gate <rev>: what a review-set run covers, as of that commit: lib/canccu-verdict.sh
# whole (the block, its parser, REVIEW.md handling), the review prompts' definitions without the
# comments above them, and REVIEW_MODEL's default. Read from git, so a shallow fetch of the tag's
# commit is enough. A listed name the file lacks prints "missing: lib/<file> <name>": a rename
# must not turn the gate off unseen (review_gate_missing).
review_gate() {
  git show "$1:lib/canccu-verdict.sh" 2>/dev/null
  # a function from its "name() {" line to its closing "}"; a variable is one line
  local f names
  for f in canccu-runs.sh:review_prompt canccu-depth.sh:light_review_prompt,LIGHT_REVIEW_TEXT canccu-norepeat.sh:norepeat_prompt; do
    names=${f#*:}
    git show "$1:lib/${f%%:*}" 2>/dev/null | awk -v names=",$names," -v file="lib/${f%%:*}" '
      in_fn { print; if ($0 ~ /^}/) in_fn = 0; next }
      match($0, /^[A-Za-z_][A-Za-z0-9_]*(\(\)|=)/) {
        n = substr($0, 1, RLENGTH); sub(/(\(\)|=)$/, "", n)
        if (index(names, "," n ",")) { seen[n] = 1; print; in_fn = ($0 ~ /^[A-Za-z0-9_]+\(\)/ && $0 !~ /}[[:space:]]*$/) }
      }
      END { k = split(substr(names, 2, length(names) - 2), w, ","); for (i = 1; i <= k; i++) if (!seen[w[i]]) print "missing: " file " " w[i] }'
  done
  git show "$1:lib/canccu-config.default" 2>/dev/null | grep '^REVIEW_MODEL='
}

# review_gate_missing: the names review_gate lists that HEAD lacks, one "lib/<file> <name>" a line
review_gate_missing() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  review_gate HEAD | sed -n 's/^missing: //p'
}

# review_set_since <tag>: prints the tag the reviewer changed since (the highest v* tag below
# <tag>, or "the first release" without one) and returns 0; returns 1 when nothing changed or
# when this is no git repo (nothing to compare)
review_set_since() {
  local prev
  git rev-parse --git-dir >/dev/null 2>&1 || return 1
  prev=$({ git tag -l 'v*'; echo "$1"; } | sort -uV | awk -v t="$1" '$0 == t { print p; exit } { p = $0 }')
  if [ -z "$prev" ]; then echo "the first release"; return 0; fi
  [ "$(review_gate "$prev")" = "$(review_gate HEAD)" ] && return 1
  echo "$prev"
}

cmd=${1:-}; shift || true
case $cmd in
  check)
    [ $# -eq 1 ] || { [ $# -eq 3 ] && [ "$2" = --body ]; } || usage
    tag=$1 v=$(version) body=${3:-}
    # a missing body file is a wrong call, not a release without scenarios
    [ -z "$body" ] || [ -f "$body" ] || usage
    [[ $tag == v* ]] || die "the tag $tag does not start with v (release tags are v<VERSION>)"
    [ "${tag#v}" = "$v" ] || die "the tag $tag is not v<VERSION>: VERSION says '${v:-nothing}'"
    head=$(section "$v" | head -n1)
    [ -n "$head" ] || die "CHANGELOG.md has no section '## [$v] — <date>'"
    # only a dated heading is a release: "unreleased" means the section is still being written
    [[ $head =~ ^\#\#\ \[[^]]+\]\ —\ [0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
      die "the CHANGELOG.md heading '$head' is not '## [$v] — <YYYY-MM-DD>' (still unreleased?)"
    if [ -n "$body" ]; then
      # the gate is the line a run of tests/scenarios/run asks for; a PR body may end in CRLF
      tr -d '\r' < "$body" | grep -qE '^Scenarios: pass at [0-9a-f]{7,40}$' ||
        die 'the release PR body has no "Scenarios: pass at <sha>" line'
      miss=$(review_gate_missing)
      [ -z "$miss" ] || die "the review gate lists names HEAD lacks (renamed? update review_gate in $0): ${miss//$'\n'/, }"
      if since=$(review_set_since "$tag"); then
        tr -d '\r' < "$body" | grep -qE '^Review set: pass at [0-9a-f]{7,40}$' ||
          die "the release PR body has no \"Review set: pass at <sha>\" line: the review prompt, REVIEW.md handling, lib/canccu-verdict.sh or REVIEW_MODEL's default changed since $since"
        rs="; the review set passed"
      fi
    fi
    echo "tag $tag matches VERSION and CHANGELOG.md${body:+; the scenarios passed}${rs:-}" ;;
  notes)
    [ $# -eq 1 ] || usage
    s=$(section "$1")
    [ -n "$s" ] || die "CHANGELOG.md has no section for $1"
    # the body without its heading, and without the blank lines around it
    tail -n +2 <<<"$s" | awk '{ l[NR] = $0 } NF { if (!first) first = NR; last = NR } END { for (i = first; first && i <= last; i++) print l[i] }' ;;
  build)
    [ $# -eq 2 ] || usage
    v=$1 dir=$2
    [ "$v" = "$(version)" ] || die "version $v is not VERSION's ($(version))"
    name=canccu-dispatcher-$v
    mkdir -p "$dir" || die "cannot create $dir"
    git archive --format=tar.gz --prefix="$name/" -o "$dir/$name.tar.gz" HEAD || die "git archive failed"
    (cd "$dir" && sha256sum "$name.tar.gz" > SHA256SUMS) || die "cannot write $dir/SHA256SUMS"
    echo "built $dir/$name.tar.gz and $dir/SHA256SUMS" ;;
  *) usage ;;
esac
