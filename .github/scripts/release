#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# .github/scripts/release — the steps of release.yml (and CI's tarball), run in the repo's top dir:
#   release check <tag>              the tag is v<VERSION>, and CHANGELOG.md has a dated section
#                                    "## [<version>] — <date>" for it (not "unreleased")
#   release notes <version>          print that section's body: the release notes
#   release build <version> <dir>    git archive of HEAD as <dir>/canccu-dispatcher-<version>.tar.gz
#                                    (every file under canccu-dispatcher-<version>/), plus
#                                    <dir>/SHA256SUMS
# Exit 0 ok, 1 a check failed, 2 a usage error.
set -uo pipefail

die() { echo "release: $1" >&2; exit "${2:-1}"; }
usage() { sed -n '3,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }

version() { local v=""; { read -r v < VERSION; } 2>/dev/null; printf '%s\n' "${v//[[:space:]]/}"; }

# section <version>: the CHANGELOG.md section of that version, its heading first. The version is
# matched as a literal: 1.2.4 must not find 1.2.40, nor its dots any character.
section() {
  awk -v want="## [$1]" '
    /^## / { if (on) exit; on = (substr($0, 1, length(want)) == want) }
    on' CHANGELOG.md 2>/dev/null
}

cmd=${1:-}; shift || true
case $cmd in
  check)
    [ $# -eq 1 ] || usage
    tag=$1 v=$(version)
    [[ $tag == v* ]] || die "the tag $tag does not start with v (release tags are v<VERSION>)"
    [ "${tag#v}" = "$v" ] || die "the tag $tag is not v<VERSION>: VERSION says '${v:-nothing}'"
    head=$(section "$v" | head -n1)
    [ -n "$head" ] || die "CHANGELOG.md has no section '## [$v] — <date>'"
    # only a dated heading is a release: "unreleased" means the section is still being written
    [[ $head =~ ^\#\#\ \[[^]]+\]\ —\ [0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] ||
      die "the CHANGELOG.md heading '$head' is not '## [$v] — <YYYY-MM-DD>' (still unreleased?)"
    echo "tag $tag matches VERSION and CHANGELOG.md" ;;
  notes)
    [ $# -eq 1 ] || usage
    s=$(section "$1")
    [ -n "$s" ] || die "CHANGELOG.md has no section for $1"
    # the body without its heading, and without the blank lines around it
    tail -n +2 <<<"$s" | awk '{ l[NR] = $0 } NF { if (!first) first = NR; last = NR } END { for (i = first; first && i <= last; i++) print l[i] }' ;;
  build)
    [ $# -eq 2 ] || usage
    v=$1 dir=$2
    [ "$v" = "$(version)" ] || die "version $v is not VERSION's ($(version))"
    name=canccu-dispatcher-$v
    mkdir -p "$dir" || die "cannot create $dir"
    git archive --format=tar.gz --prefix="$name/" -o "$dir/$name.tar.gz" HEAD || die "git archive failed"
    (cd "$dir" && sha256sum "$name.tar.gz" > SHA256SUMS) || die "cannot write $dir/SHA256SUMS"
    echo "built $dir/$name.tar.gz and $dir/SHA256SUMS" ;;
  *) usage ;;
esac
