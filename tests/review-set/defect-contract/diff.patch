diff --git a/bin/tally b/bin/tally
index a31f65b..aff12de 100755
--- a/bin/tally
+++ b/bin/tally
@@ -1,7 +1,7 @@
 #!/usr/bin/env bash
 # SPDX-License-Identifier: AGPL-3.0-or-later
 # tally — named counters in a file (docs/format.md)
-#   tally add <name> [n]   add n (default 1) to the counter
+#   tally add <name> [n] [--note <text>]   add n (default 1) to the counter, keep a note with it
 #   tally show [name]      every counter, or one
 #   tally reset <name>     remove a counter
 set -euo pipefail
@@ -12,12 +12,13 @@ here=$(cd "$(dirname "$0")/.." && pwd)
 cmd=${1:-}; shift || true
 case $cmd in
   add)
-    name=${1:?tally add <name> [n]} n=${2:-1}
+    name=${1:?tally add <name> [n] [--note <text>]} n=${2:-1} note=""
+    [ "${3:-}" = --note ] && note=${4:-}
     valid_name "$name" || { echo "tally: bad name $name" >&2; exit 2; }
     [[ $n =~ ^[0-9]+$ ]] || { echo "tally: bad count $n" >&2; exit 2; }
-    store_set "$name" $(( $(store_get "$name") + n )) ;;
+    store_set "$name" $(( $(store_get "$name") + n )) "${note:-$(store_note "$name")}" ;;
   show)
-    if [ $# -gt 0 ]; then printf '%s\t%s\n' "$1" "$(store_get "$1")"; else store_list; fi ;;
+    if [ $# -gt 0 ]; then printf '%s\t%s%s\n' "$1" "$(store_get "$1")" "$(n=$(store_note "$1"); [ -n "$n" ] && printf '\t%s' "$n")"; else store_list; fi ;;
   reset)
     name=${1:?tally reset <name>}
     valid_name "$name" || { echo "tally: bad name $name" >&2; exit 2; }
diff --git a/lib/store.sh b/lib/store.sh
index 18568cf..b6cefa9 100644
--- a/lib/store.sh
+++ b/lib/store.sh
@@ -13,10 +13,13 @@ store_get() {
   awk -F '\t' -v n="$1" '$1 == n { c = $2 } END { print c + 0 }' "$f"
 }
 
-# store_set <name> <count>: through a temp file, so a failed write keeps the old file
+# store_note <name>: its note, nothing when there is none
+store_note() { local f; f=$(store_file); [ -f "$f" ] && awk -F '\t' -v n="$1" '$1 == n { print $3 }' "$f"; return 0; }
+
+# store_set <name> <count> [note]: through a temp file, so a failed write keeps the old file
 store_set() {
   local f; f=$(store_file)
-  { [ -f "$f" ] && awk -F '\t' -v n="$1" '$1 != n' "$f"; printf '%s\t%s\n' "$1" "$2"; } |
+  { [ -f "$f" ] && awk -F '\t' -v n="$1" '$1 != n' "$f"; if [ -n "${3:-}" ]; then printf '%s\t%s\t%s\n' "$1" "$2" "$3"; else printf '%s\t%s\n' "$1" "$2"; fi; } |
     LC_ALL=C sort > "$f.tmp" && mv "$f.tmp" "$f"
 }
 
diff --git a/tests/store.sh b/tests/store.sh
index 81b42bb..7b9253b 100644
--- a/tests/store.sh
+++ b/tests/store.sh
@@ -15,5 +15,7 @@ check "the file is sorted" "$(t show)" "$(printf 'apples\t3\npears\t1')"
 t reset apples
 check "reset removes the counter" "$(t show)" "$(printf 'pears\t1')"
 check "an unknown name counts 0" "$(t show plums)" "$(printf 'plums\t0')"
+t add limes 2 --note green
+check "add --note keeps the note" "$(t show limes)" "$(printf 'limes\t2\tgreen')"
 # --- new checks above this line
 exit "$fail"
