#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# tests/review-set/run — the reviewer's test set (docs/reference/review-set.md): the real review
# prompt, on the real model, against fixed cases with a planted defect or none.
#   tests/review-set/run [--model <m>] [--effort <e>] [--light]
# Per case: "<case> found|missed|clean|blocked", then the totals. Appends a line to review-set.log
# in the project's home; the first run writes the baseline (review-set-baseline, with --light
# review-set-baseline-light), each later one is judged against it, and a red one engages the
# review brake with REVIEW_BRAKE=auto. Exit 0 green (or the baseline written), 1 red, 2 a usage
# error. It costs model tokens: not part of tests/run, nor CI. REVIEW_SET_ENGINE replaces claude.
set -uo pipefail
root=$(cd "$(dirname "$0")/../.." && pwd); here=$root/tests/review-set
usage() { sed -n '3,10s/^# \{0,1\}//p' "$0" >&2; exit 2; }

model="" effort="" light=0
while (( $# )); do
  case $1 in
    --model) [ -n "${2:-}" ] || usage; model=$2; shift ;;
    --effort) effort=${2:-}; shift ;;
    --light) light=1 ;;
    *) usage ;;
  esac
  shift
done
case $effort in ""|low|medium|high|xhigh|max) ;; *) usage ;; esac
# the light review always runs at low effort (start_reviewer): another effort is no light review
(( light )) && [ -n "$effort" ] && usage
mapfile -t cases < <(cd "$here" && for d in */; do [ -f "$d/expect" ] && echo "${d%/}"; done)
(( ${#cases[@]} )) || { echo "review-set: no cases in $here" >&2; exit 2; }

# the project the result is for: its home holds the log, the baseline and the brake
home=$(. "$root/lib/canccu-common.sh" >/dev/null && echo "$CANCCU_HOME") || exit 2
W=$(mktemp -d); trap 'rm -rf "$W"' EXIT
user_root=${CANCCU_ROOT:-} user_project=${CANCCU_PROJECT:-}

# the cases run in a dispatcher home of their own (project tools), so the prompt is built from the
# default rules and no state of the real project leaks into it, nor any of a case into the project
mkdir -p "$W/root/projects/tools/state" "$W/bin"
sed "s/@NAME@/tools/g" "$root/profiles/default/rules" > "$W/root/projects/tools/rules"
printf '%s\n' "REPO=example-user/tools" "CLONE=$W/clone" "USER_LOGIN=octo" "REVIEWER_LOGIN=review-bot" \
  "DIGEST_HOUR_UTC=24" 'ADD_DIRS=""' > "$W/root/projects/tools/config"
# the reviewer reads the case's issue and PR through gh: this one answers from the case and
# reaches nothing else (the files' first line is their licence comment, no part of the case)
cat > "$W/bin/gh" <<'EOF'
#!/usr/bin/env bash
case "$1 $2" in
  "issue view") tail -n +2 "$REVIEW_SET_CASE/issue.md" ;;
  "pr view") tail -n +2 "$REVIEW_SET_CASE/pr.md" ;;
  "pr diff") git diff origin/main HEAD ;;
  *) echo "gh: only issue view, pr view and pr diff answer in the review set" >&2; exit 1 ;;
esac
EOF
chmod +x "$W/bin/gh"

# reviewer <dir> <review file> <sha> <case dir> <prompt>: one review, in the case's repo
reviewer() {
  local turns cost mins
  if [ -n "${REVIEW_SET_ENGINE:-}" ]; then (cd "$1" && "$REVIEW_SET_ENGINE" "$2" "$3" "$4" <<<"$5"); return; fi
  read -r turns cost mins <<<"$BUDGET_REVIEW"
  # the engine's flags for an untrusted run (libexec/canccu-worker), in the foreground; the effort
  # is the prompt's, as the dispatcher's reviewer gets it
  (cd "$1" && REVIEW_SET_CASE=$4 PATH="$W/bin:$PATH" timeout -k 10 "${mins}m" claude -p --permission-mode auto \
     --permission-prompts none --max-budget-usd "$cost" --setting-sources user --strict-mcp-config \
     ${model:+--model "$model"} --add-dir "${2%/*}" -- "$5") > "$W/${4##*/}.out" 2>&1
}

# one <case>: builds the case's repo where the dispatcher keeps a PR's review worktree, runs the
# reviewer and prints the result. The unit is issue 7, its PR 8.
one() (
  local c=$1 d=$here/$1 n=7 pr=8 wt sha f e want got loc
  export CANCCU_ROOT=$W/root CANCCU_PROJECT=tools
  # shellcheck source=../../lib/canccu-common.sh
  . "$root/lib/canccu-common.sh" >/dev/null || exit 2
  wt=$(review_wt "$pr"); rm -rf "$wt" "$CANCCU_HOME/reviews" "$CANCCU_HOME/state/$n"; mkdir -p "$wt"
  cp -a "$d/base/." "$wt/" &&
    { cd "$wt" && git init -q && git add -A && git -c user.name=octo -c user.email=octo@users.noreply.github.com commit -qm base &&
      git update-ref refs/remotes/origin/main HEAD && git checkout -q -b "$n-change" && git apply --index "$d/diff.patch" &&
      git -c user.name=octo -c user.email=octo@users.noreply.github.com commit -qm "the change for #$n"; } >/dev/null 2>&1 ||
    { echo "missed (the case does not build)"; exit 0; }
  sha=$(git rev-parse HEAD)
  st_set "$n" phase=review pr="$pr" review_mode=review risk=low risk_reason="a small change to one command"
  if [ -f "$d/history" ]; then mkdir -p "$(dirname "$(history_file "$pr")")"; cp "$d/history" "$(history_file "$pr")"; fi
  PRS=$(jq -n --arg b "$(tail -n +2 "$d/pr.md")" --arg h "$n-change" '[{number: 8, headRefName: $h, body: $b}]')
  f=$(review_file "$pr" "$sha"); mkdir -p "${f%/*}"
  if (( light )); then prompt=$(light_review_prompt "$pr" "$n" "$sha" "$f")
  else prompt=$(review_prompt "$pr" "$n" "$sha" "$f" "${effort:-high}"); fi
  reviewer "$wt" "$f" "$sha" "$d" "$prompt"
  # judged as the dispatcher judges a verdict: the no-repeat context, then its demotions
  local REVIEW_SETTLED REVIEW_PASSRULE REVIEW_CHANGED
  review_ctx "$n" "$pr" "$sha"
  e=$(review_effective "$f" "$sha")
  want=$(sed -n 's/^defect [^ ]* //p' "$d/expect")
  if [ -z "$want" ]; then [ "${e%% *}" = pass ] && echo clean || echo blocked; exit 0; fi
  [ -n "$e" ] && got=$(_review_awk keys < "$f") || got=""
  # a planted defect is found by a blocking finding left on its file, within 5 lines of it: the
  # class a reviewer gives it may differ, and where it points in a hunk may too
  for loc in $want; do
    awk -F '\t' -v f="${loc%:*}" -v l="${loc##*:}" '
      { split($3, r, "-"); lo = r[1] + 0; hi = (r[2] == "" ? lo : r[2] + 0) }
      $2 == f && lo - 5 <= l + 0 && l + 0 <= hi + 5 { hit = 1 } END { exit !hit }' <<<"$got" || { echo missed; exit 0; }
  done
  echo found
)

found=() missed=() blocked=() clean=() red=()
for c in "${cases[@]}"; do
  r=$(one "$c"); echo "$c $r"
  case ${r%% *} in found) found+=("$c") ;; clean) clean+=("$c") ;; blocked) blocked+=("$c") ;; *) missed+=("$c") ;; esac
done
echo "found ${#found[@]} · missed ${#missed[@]} · clean ${#clean[@]} · blocked ${#blocked[@]}"

list() { local IFS=,; echo "${*:--}"; }
# both kinds of miss are named: a blocked clean case missed its result as much as a missed defect
CANCCU_ROOT=$user_root CANCCU_PROJECT=$user_project
(( light )) && effort=light
sha=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo -)
base=$home/review-set-baseline; (( light )) && base+=-light
(
  # shellcheck source=../../lib/canccu-common.sh
  . "$root/lib/canccu-common.sh" >/dev/null || exit 2
  t=$(iso "$(now)")
  echo "$t $sha ${model:-default} ${effort:-high} ${#found[@]} ${#missed[@]} ${#blocked[@]} $(list "${missed[@]}" "${blocked[@]}")" >> "$home/review-set.log" ||
    echo "review-set: cannot append to $home/review-set.log" >&2
  if [ ! -s "$base" ]; then
    echo "$t $sha ${model:-default} ${effort:-high} ${#blocked[@]} $(list "${found[@]}")" > "$base" || exit 2
    echo "baseline written: ${base/#$HOME/\~}"; exit 0
  fi
  read -r _ _ _ _ bblocked bfound < "$base"
  for c in "${missed[@]}"; do [[ ,$bfound, == *,$c,* ]] && red+=("$c"); done
  (( ${#blocked[@]} > ${bblocked:-0} )) && red+=("${blocked[@]}")
  (( ${#red[@]} )) || { echo "green against the baseline of $(cut -d' ' -f1-2 "$base")"; exit 0; }
  echo "red: $(list "${red[@]}")"
  review_set_red "$(list "${red[@]}")"
  exit 1
)
