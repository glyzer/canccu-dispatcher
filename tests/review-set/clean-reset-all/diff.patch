diff --git a/bin/tally b/bin/tally
index a31f65b..b94e3f8 100755
--- a/bin/tally
+++ b/bin/tally
@@ -3,7 +3,7 @@
 # tally — named counters in a file (docs/format.md)
 #   tally add <name> [n]   add n (default 1) to the counter
 #   tally show [name]      every counter, or one
-#   tally reset <name>     remove a counter
+#   tally reset <name>     remove a counter; --all: every counter
 set -euo pipefail
 here=$(cd "$(dirname "$0")/.." && pwd)
 # shellcheck source=../lib/store.sh
@@ -19,7 +19,8 @@ case $cmd in
   show)
     if [ $# -gt 0 ]; then printf '%s\t%s\n' "$1" "$(store_get "$1")"; else store_list; fi ;;
   reset)
-    name=${1:?tally reset <name>}
+    name=${1:?tally reset <name>|--all}
+    if [ "$name" = --all ]; then store_clear; exit 0; fi
     valid_name "$name" || { echo "tally: bad name $name" >&2; exit 2; }
     store_del "$name" ;;
   *) echo "usage: tally add|show|reset" >&2; exit 2 ;;
diff --git a/lib/store.sh b/lib/store.sh
index 18568cf..152afce 100644
--- a/lib/store.sh
+++ b/lib/store.sh
@@ -27,4 +27,7 @@ store_del() {
   awk -F '\t' -v n="$1" '$1 != n' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
 }
 
+# store_clear: every counter goes, and the file with them
+store_clear() { rm -f "$(store_file)"; }
+
 store_list() { local f; f=$(store_file); [ -f "$f" ] && cat "$f"; return 0; }
diff --git a/tests/store.sh b/tests/store.sh
index 81b42bb..fd49745 100644
--- a/tests/store.sh
+++ b/tests/store.sh
@@ -15,5 +15,7 @@ check "the file is sorted" "$(t show)" "$(printf 'apples\t3\npears\t1')"
 t reset apples
 check "reset removes the counter" "$(t show)" "$(printf 'pears\t1')"
 check "an unknown name counts 0" "$(t show plums)" "$(printf 'plums\t0')"
+t add kiwis; t reset --all
+check "reset --all removes every counter" "$(t show)" ""
 # --- new checks above this line
 exit "$fail"
