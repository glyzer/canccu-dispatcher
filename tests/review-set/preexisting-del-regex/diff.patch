diff --git a/bin/tally b/bin/tally
index da3274f..acdf85b 100755
--- a/bin/tally
+++ b/bin/tally
@@ -17,7 +17,10 @@ case $cmd in
     [[ $n =~ ^[0-9]+$ ]] || { echo "tally: bad count $n" >&2; exit 2; }
     store_set "$name" $(( $(store_get "$name") + n )) ;;
   show)
-    if [ $# -gt 0 ]; then printf '%s\t%s\n' "$1" "$(store_get "$1")"; else store_list; fi ;;
+    if [ $# -gt 0 ]; then
+      valid_name "$1" || { echo "tally: bad name $1" >&2; exit 2; }
+      printf '%s\t%s\n' "$1" "$(store_get "$1")"
+    else store_list; fi ;;
   reset)
     name=${1:?tally reset <name>}
     store_del "$name" ;;
diff --git a/tests/store.sh b/tests/store.sh
index 81b42bb..ec0c76e 100644
--- a/tests/store.sh
+++ b/tests/store.sh
@@ -15,5 +15,6 @@ check "the file is sorted" "$(t show)" "$(printf 'apples\t3\npears\t1')"
 t reset apples
 check "reset removes the counter" "$(t show)" "$(printf 'pears\t1')"
 check "an unknown name counts 0" "$(t show plums)" "$(printf 'plums\t0')"
+check "show of a bad name: exit 2" "$(t show 'Bad Name' 2>&1; echo "rc=$?")" "$(printf 'tally: bad name Bad Name\nrc=2')"
 # --- new checks above this line
 exit "$fail"
