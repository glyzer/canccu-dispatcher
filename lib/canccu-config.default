# SPDX-License-Identifier: AGPL-3.0-or-later
# shellcheck shell=bash disable=SC2034
# canccu-dispatch defaults, for every project. A canccu-* command reads this file, then the host
# profile (hosts/<HOST_PROFILE>.conf: the values that suit the Claude plan and the host), then
# ~/.canccu/config (global: TOTAL_CAP, and a default for every project), then the project's
# rules and last its config (~/.canccu/projects/<name>/{rules,config}): a key either of those
# sets wins over the global one (a rules file may set every rules key). TOTAL_CAP is read from
# ~/.canccu/config only. Keep ~/.canccu/config as a copy of this file with every value commented
# out: uncomment and change only what you need. See docs/canccu-dispatch.md.
#
# Each project's config sets at least REPO and CLONE (canccu-init writes them).
REPO=
CLONE=
BASE_BRANCH=main            # the repo's base branch: worktrees start from it, PRs merge into it, its CI is the one shown; canccu-init writes it
HOST_PROFILE=               # the host profile (hosts/<name>.conf, e.g. max); ~/.canccu/config or CANCCU_HOST_PROFILE only; empty: none
CAP=3                       # workers + reviewers + answerers of this project running at once
TOTAL_CAP=3                 # the same over all projects together (one Claude account); ~/.canccu/config only
CLONE_ROOT=$HOME/code       # where canccu-init clones a new project, and where canccu-up's panes start (docs/hosts.md)
EXTRA_PATH=                 # dirs put first on PATH for every command and run, colon-separated (cron starts with a bare PATH); empty: none
GUARD_VMEM_KB=2000000       # the virtual-memory cap of every gh, jq and python3 call, in KB: a runaway kills itself, not the host
WORKER_SKILLS=              # the skill sentence of the worker, package and health prompts; empty: no skill named (docs/hosts.md)
REVIEW_SKILLS="code-review security-review"   # the reviewer's two skills: the one that reviews the diff, then the security one
HEALTH_CHECKLIST="1. files over the size limit in AGENTS.md are split up; 2. dead code for dropped features and old names is removed; 3. comments follow the comment rule in AGENTS.md; 4. duplicated logic is merged."   # the health pass's checklist, and nothing else
MERGE_METHOD=squash         # squash, merge or rebase: how a PR merges without a merge queue; one the repo does not allow → the repo's own
MODEL=                      # every run gets --model $MODEL; empty: no --model, the account default
USER_LOGIN=                 # your GitHub login: whose PRs are ours, who is pinged; unset → the dispatcher does nothing
REVIEWER_LOGIN=             # the reviewer bot's login: reviews post as it, only its verdicts count; unset → no reviews
REVIEWER_TOKEN_FILE=$CANCCU_ROOT/reviewer-token   # its token, mode 600, one for all projects; no file → no reviews
GH_CONFIG_DIR=               # the project's own gh login (a narrow token): empty → ~/.canccu/projects/<name>/gh when it exists, else the default gh login
ALLOW_DEFAULT_GH_LOGIN=0    # 1: a project without its own gh login may run on the host's default login; 0: it starts no run
HOST_LABEL=                 # a name for this host in the repo's dispatcher claim (docs/hosts.md); empty: its random id only. Never a hostname you keep private
CLAIM_RENEW_MIN=10          # minutes between two writes of this host's dispatcher claim
CLAIM_EXPIRY_MIN=30         # a claim not written for this long is free: another host may take the repo; keep it well above CLAIM_RENEW_MIN
UPGRADE=auto                # auto: after an install makes a new release current, the dispatcher starts nothing new and moves to it once the project is idle; manual: it only says so
BUDGET_WORK="250 80 150"    # turns, USD, minutes: a new issue
BUDGET_RESUME="80 20 45"    # a follow-up run of a worker (review fixes, red CI, plan OK, answers)
RESUME_ON=answer,plan       # follow-ups that resume the session (answer plan fix ci needs-work merge limited blocked crash user, or all); the rest start fresh with a handoff
FIX_ATTEMPTS=2              # automatic fix runs per PR (review fix rounds plus red-CI fixes), then needs-you
FIX_EXTRA_IF_FEWER=1        # 1: one more automatic fix round when the last verdict has fewer blocking findings than the one before; 0: stop as today
CRASH_RETRY=1               # fresh runs with the handoff after a worker crashed, stalled or was killed, then needs-you
CONTINUE_MAX=3              # fresh runs with the handoff after a worker stopped at its turn or time budget with its PR moved on, within the USD of BUDGET_WORK; 0: needs-you at once
FIX_MODEL=                  # the fix run's model (review fixes, red CI, needs-work); empty: MODEL
FIX_EFFORT=                 # the fix run's --effort (low, medium, high, xhigh, max); empty: none, the account's
TEST_TIER=targeted          # what a run tests locally: targeted (the touched areas' test files and the repo checks) or full (the full suite once before ready); CI runs the full suite either way
BUDGET_REVIEW="60 15 40"    # the independent reviewer
BUDGET_FIXCHECK="30 6 20"   # the fix-check after the worker fixed the review's findings
BUDGET_ANSWER="40 10 20"    # the answerer of a worker's question
ANSWER_MAX=3                # answerer rounds per issue, then needs-you
STALL_MIN=10                # kill a run whose log and tools are silent this long
RUN_TMPDIR=disk             # disk: each run gets its own temp dir under the workers dir, removed when it ends; system: the inherited TMPDIR
DIGEST_HOUR_UTC=6
DIGEST_ISSUE=               # the pinned "Daily digest" issue; empty: the digest is written, never posted
PING=on                     # on|off: @mention USER_LOGIN in a comment as REVIEWER_LOGIN when something needs them
INTERVAL=60                 # seconds between passes
CI_WAIT_MIN=90              # a finished worker's PR with CI still pending this long → needs-you
NO_CHECKS_MIN=10            # a finished worker's PR with no CI check reported this long → needs-you
IDLE_ALARM_MIN=60           # a unit no rule moved this long, with nothing running → one idle line in the feed
MERGE_WAIT_MIN=240          # auto-merge armed this long without a merge → disarmed, needs-you
MERGE_CLOSE_MIN=2           # a merged PR's named issue still open this long → the dispatcher closes it
MERGE_RETRY=3               # a merge that fails on a GitHub server error is tried again on this many passes, then needs-you
ACCEPT_CHANNELS=all         # which accepts count: label (the accepted label), ship (canccu-ship), reply (an answer comment), leader (the leader's canccu-ship); all: every one
KEEP_ACCEPT_ON_MAIN_MERGE=1 # 1: an accept carries over merges of main: clean ones, and resolved ones once their fix-check passes; 0: asked again
MERGE_MAIN_ANY_PHASE=1      # 1: a PR that conflicts with main gets main merged in by script in every phase; 0: only at the accept and merge steps
POST_WAIT=600               # seconds a posted review may take to show up on GitHub
# work packages per step (docs/canccu-dispatch.md, "Work packages per step")
STEP_BUDGET=400             # USD per step: its planner, package, review, fix-check, answer and health runs
BUDGET_PLAN="60 10 30"      # the planner of a step's wave
BUDGET_HEALTH="250 60 150"  # the health pass at the end of a step
BUDGET_PACKAGE_MAX="600 200 360"   # cap on a package's budget (work, resume, review times its issue count)
PACKAGE_LINES=1500          # the planner's size guide: changed lines per package
BUDGET_LINES=300            # above 0: a package's budgets scale with its planned changed lines over this, when more than its issue count
PACKAGE_MIN_ISSUES=3        # above 1: the planner aims for at least this many issues per package (where they fit together)
PACKAGE_HOLD_SMALL=0        # 1: the planner may leave a lone small leftover out for a later wave's package of its area
PLAN_MODEL=                 # the planner's model; empty: MODEL
WAVE_ROLLING=0              # 1: plan the next wave while this one runs, once nothing waits to start and a slot is free; 0: wait for the wave to be over
REVIEW_MODEL=               # the full reviewer's model; empty: MODEL
REVIEW_MODEL_LIGHT=         # the full reviewer's model for a light PR (docs, tests, LIGHT_REVIEW_PATHS only); empty: REVIEW_MODEL
FIXCHECK_MODEL=             # the fix-check's model (e.g. a cheaper one); empty: MODEL
FIXCHECK_FULL_LINES=100     # a push after a passed review changing more lines than this gets a full review, not a fix-check
FIXCHECK_COUNT_MAIN=0       # 0: a fix's size counts only the PR's own change; 1: main's lines merged into the PR's files count too
FINDINGS_RECUR=3            # merged PRs with findings of the same key (class + file) before the dispatcher files one recurring-finding issue; 0: never
FINDINGS_RECUR_DAYS=30      # the window, in days, FINDINGS_RECUR counts over
FIXCHECK_COUNT_RESOLVED=1   # 1 (with FIXCHECK_COUNT_MAIN=0): after a conflicting merge of main, count only the resolved lines
HEALTH_MODEL=               # the health pass's model (e.g. a cheaper one); empty: MODEL
HEALTH_EFFORT=              # the health pass's --effort (low, medium, high, xhigh, max); empty: none, the account default
STEP_DEEP_REVIEW=1          # 1: a step whose work is done gets a deep review of its whole change first; its blocking findings become a polish issue
DEEP_REVIEW_MODEL=          # the deep review's model; empty: REVIEW_MODEL, else MODEL
DEEP_REVIEW_EFFORT=medium   # the deep review's --effort (low, medium, high, xhigh, max), under REVIEW_EFFORT_MAX
BUDGET_DEEP_REVIEW="150 40 120"   # the deep review at the end of a step
CADENCE_DAYS=14             # above 0: a step whose milestone description has the line "Cadence: on" gets a review round every this many days
STEP_TAG='step-{n}'         # the checkpoint OK tags origin/main ({n}: the title's leading number); empty: no tag; locked
# the usage throttle (shares of the Claude account's limits, from the rate-limit reports in the runs' output)
USAGE_SLOW=60               # 5-hour share (%) from which one run at a time runs, over all projects
USAGE_STOP=90               # … from which no run starts and running workers are nudged to stop
USAGE_WEEKLY_DRAIN=90       # weekly share (%) from which nothing new starts; started work finishes
USAGE_WINDOW_DELTA=0        # 1: each run's spend.log line has the 5-hour share before and after it (one run at a time only)
PACE=cap                    # weekly pacing against the time gone: off, notify, cap (at most PACE_CAP runs) or pause (nothing new starts)
PACE_MARGIN=10              # points the weekly share may be ahead of the share of the week gone
PACE_CAP=1                  # PACE=cap: the runs at once over all projects while ahead
USAGE_MAX_AGE_MIN=360       # a usage reading older than this (minutes) counts as unknown; 0: never
DISK_MIN_MB=200             # below this free space (MB) where the worktrees live, a pass starts nothing new and says so

# ---- rules: the project's rules file (~/.canccu/projects/<name>/rules) sets these. It lives
# on this host, never in the repo, so a PR can never change its own gating.
# risky paths (grep -iE on each changed path): a full review of a PR touching one runs at high
# effort, unless the PR has a risk class (a package's: then high only for a high class)
RISKY_PATHS='^(\.github|deploy)/|migration|sign-?in|login|auth|rights|permission|session|secret|tenan|rls'
# paths (grep -E) that count as docs for a full review's effort, on top of docs/ and *.md, even
# when RISKY_PATHS names them; never agent configuration or a gated path
EFFORT_DOCS_PATHS=''
# cost kinds for canccu-status --costs and the digest: "<name>=<regex>;<name>=<regex>", grep -iE on
# the merged PR title (e.g. 'packs=^docs\(briefs\);screenshots=screenshot|demo-stack'); the rest is "other"
COST_KINDS=''
COST_ROUNDS_ALERT=5         # the digest names an issue with more fix rounds than this in the last 24 h; 0: never
REVIEW_EFFORT_MAX=''        # cap for the review and fix-check effort: low, medium, high, xhigh or max; empty: none
# the same as RISKY_PATHS for a fix-check's fix diff: medium instead of low effort
FIXCHECK_RISKY='(^|/)deploy/|sign-?in|login|auth|rights|permission|session|secret|tenan|(^|[/_.-])rls([/_.-]|$)|migrations?(/|_|\.|$)|\.sql$|schema'
# gated paths (grep -E): a PR touching one waits for the user's accept. Agent configuration
# (.claude/, .mcp.json, CLAUDE.md, AGENTS.md) is always gated on top of these.
GATED_PATHS='^\.github/'
# grep -E on the PR's paths: a match always waits for the product owner (pages, screens,
# wording, step briefs); a path TEST_PATHS matches never counts
USER_VISIBLE_PATHS=''
TEST_PATHS='(^|/)(tests?|__tests__|spec)/|\.(test|spec)\.[a-z]+$'   # grep -E: test files, never user-visible
TEST_CMD='tests/run'        # the repo's test command: a run's calls of it are counted and timed (canccu-status --kpi); empty: not measured
# grep -E on the PR's paths: a PR whose every path is docs, a test (TEST_PATHS) or matches this is
# reviewed with REVIEW_MODEL_LIGHT; never a gated path or agent configuration
LIGHT_REVIEW_PATHS=''
SECURITY_REVIEW_WHEN='sign-in, rights, sessions, secrets, tenancy/RLS or deploy/'   # the reviewer also runs security-review when the diff touches these
PLANNER_EXTRA=''            # the project's guidance for the planner, e.g. "aim for 2-4 issues per package"
REVIEW_EXTRA=''             # more for the reviewer to check: "Check every acceptance criterion, <this>, and …"
WORKER_EXTRA=''             # more worker prompt text, after "… resumes you when it is red."
ANSWER_READ='AGENTS.md'     # what the answerer reads besides the issue and the PR
ANSWER_READ_ALSO=''         # … and, after the PR, "and <this>"
AUTO_MERGE_UNTIL=''         # optional YYYY-MM-DD: from this date every PR waits for the user's accept
EXCLUSIVE_LABEL=''          # optional: issues with this label run one at a time
EXCLUSIVE_PATTERN=''        # optional (grep -E): … and those whose body or plan matches this
EXCLUSIVE_WORKER_RE=''      # optional (grep -iE): the run engine's own check on the issue's JSON
ADD_DIRS=''                 # extra read-only dirs for workers (--add-dir), space-separated
REVIEW_CHECKS="review-gate" # checks that wait for the review verdict: not required before the review
HIGH_RISK_PATHS='^(\.github|deploy)/|migration|sign-?in|login|auth|rights|permission|session|secret|tenan|rls'   # grep -iE: a health pass touching one is high risk
HIGH_RISK_TEXT='migrations, sign-in or auth, rights, sessions, secrets, tenancy/RLS, deploy/ or CI configuration'   # high-risk content, in words, for the planner and the reviewer
REVIEW_LIGHT=1              # 1: a package of class low or normal gets a light review (a checklist at low effort); locked
PING_KINDS=all              # the ping kinds (PING=on): all, or some of accept checkpoint plan question needs-you pr-needs-you; empty: none
NOTIFY_CONTENT=full         # full|link: what an ask carries (the ping, the PR body block); link: its first line and the link only
# the notifications (docs/reference/notify.md): where an ask of the product owner goes; locked
NOTIFY=github               # github (the ping, PING on), telegram, both, or off (nothing, no ping either)
TELEGRAM_CHAT_ID=''         # the chat the bot writes to: a group with topics (-100…) or a private chat
TELEGRAM_USER_ID=''         # the product owner's Telegram user id: only their replies reach the inbox
TELEGRAM_TOKEN_FILE=$HOME/.config/canccu/telegram-token   # the bot token, mode 600, outside every repo
# what reaches Telegram, and when (docs/reference/notify.md): the product owner gets what needs them,
# batched, not at night; class interrupt always goes at once
NOTIFY_KINDS='accept plan question needs-you checkpoint step-done'   # the kinds sent; also idle, hold, polish, handover
NOTIFY_BATCH_MIN=10         # items that come within this many minutes go as one message; 0: each at once
QUIET_HOURS=''              # for example 22-07: nothing but class interrupt is sent then; empty: off
QUIET_TZ=''                 # the time zone of QUIET_HOURS and NOTIFY_DIGEST_HOUR; empty: the host's
NOTIFY_MAX_PER_DAY=12       # messages a day; over it, the items wait for the digest
NOTIFY_DIGEST_HOUR=''       # the hour the day's digest goes to Telegram, in a topic of its own; empty: never
NOTIFY_REMIND_H=0           # an item open longer than this many hours is listed again in the digest; 0: never
# the leader (an optional AI session that watches the project): which waiting items are its, and
# not the product owner's (docs/reference/leader.md). LEADER=off: every item is the product owner's
LEADER=off                  # on or off
LEADER_ACCEPTS=none         # technical or none: the accepts the owner rule gives the leader
LEADER_ACCEPTS_HIGH_RISK=0  # 1: a high-risk accept is the leader's too (LEADER_ACCEPTS=technical)
# the review brake (docs/reference/reviews.md): reviews block as before Q1 again when the escaped
# defects per merged PR rise above the baseline of the PRs merged before Q1; locked
REVIEW_BRAKE=auto           # auto: the escaped-defect trigger engages it; off: never engaged by itself
BRAKE_WINDOW=20             # the merged PRs the trigger, the baseline and canccu-status --kpi-review count
