#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# libexec/canccu-pre-push — the pre-push hook of a worker worktree (PRE_PUSH_CMD, #328): the
# project's quick check runs on the branch's changed files before a push leaves, so a lint error
# costs a minute here instead of a red CI round and a fix run. The worktree's hook (written by
# lib/canccu-engine.sh, prepush_setup) sets PRE_PUSH_CMD, PRE_PUSH_MAX_SEC and PRE_PUSH_BASE.
set -uo pipefail
cat > /dev/null   # the refs git sends: the check looks at the whole branch
max=${PRE_PUSH_MAX_SEC:-600}; [[ $max =~ ^[1-9][0-9]*$ ]] || max=600
# deleted files are left out: a check given a path that is gone fails on it
mapfile -t files < <(git -c core.quotePath=off diff --name-only --diff-filter=d "origin/${PRE_PUSH_BASE:-main}...HEAD" 2>/dev/null)
CANCCU_CHANGED_FILES=$(printf '%s\n' "${files[@]}"); CANCCU_CHANGED_FILES=${CANCCU_CHANGED_FILES%$'\n'}
export CANCCU_CHANGED_FILES
out=$(mktemp "${TMPDIR:-/tmp}/canccu-pre-push.XXXXXX") || exit 1
trap 'rm -f "$out"' EXIT
timeout -k 10 "$max" bash -c "$PRE_PUSH_CMD"' "$@"' canccu-pre-push "${files[@]}" < /dev/null > "$out" 2>&1
rc=$?
(( rc == 0 )) && exit 0
{
  if (( rc == 124 || rc == 137 )); then
    echo "pre-push: PRE_PUSH_CMD timed out after $max s: the push is refused. Make the check pass faster, or fix what it shows, then push again."
  else
    echo "pre-push: PRE_PUSH_CMD failed (exit $rc): the push is refused. Fix what it shows first, then push again."
  fi
  echo "pre-push: \`$PRE_PUSH_CMD\`, the last 80 lines of its output:"
  tail -n 80 "$out"
} >&2
exit 1
